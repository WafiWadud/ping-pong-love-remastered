#!/usr/bin/env bash
#
# exe - A portable custom shebang interpreter
#
# This script provides a predictable alternative to kernel-specific shebang
# parsing by implementing its own command-line interpretation.
#
# THE PROBLEM:
#   Traditional shebangs allow only one optional argument, and kernels parse
#   this inconsistently:
#
#   #!/usr/bin/env head -4
#
#   Linux:   env "head -4" <script>        (treats as single argument)
#   macOS:   env head -4 <script>          (splits on first space)
#   illumos: Not reliably supported        (strictest interpretation)
#
# THE SOLUTION:
#   Use a new convention: #!exe <command...>
#   The script reads and parses its own shebang line with proper shell quoting.
#
# USAGE:
#   #!exe head -n 4
#   #!exe awk 'NR <= 10'
#   #!exe python3 -u
#
#   The kernel resolves a bare "exe" relative to the *current directory*, so
#   running a script by its own name (./script) only works from the directory
#   that contains this file. "./exe script" works from anywhere.
#
# FLAGS:
#   --pop-shebang   Skip the shebang line when passing script to command.
#                   By default, the entire script (including shebang) is piped to stdin.
#                   Use this flag to exclude the #!exe line from the input.
#
#   Example: exe script.sh --pop-shebang
#
# DESIGN NOTES:
#   - Understands '...' and "..." quoting and backslash escapes, but expands
#     nothing: no $vars, globs, ~ or command substitution, and ; | & < > are
#     ordinary characters. What you write is what the command gets.
#   - No aliases (scripts must reference real executables)
#   - Non-interactive (no rc files sourced)
#   - Script arguments are forwarded after interpreter command
#   - Falls back to normal exec for non-#!exe files
#
# PORTABILITY:
#   Works on Linux, macOS, *BSD, and most POSIX systems with bash. It avoids
#   bash-4-only features (mapfile -d, empty-array expansion under set -u), so
#   the stock macOS bash 3.2 should be fine.
#   Cannot work on illumos as a shebang due to kernel limitations.
#

set -euo pipefail

die() {
  printf 'exe: error: %s\n' "$1" >&2
  exit "${2:-1}"
}

(($#)) || die 'usage: exe <script> [args...] [--pop-shebang]' 2

# squish STRING: print STRING with runs of blanks collapsed and the ends
# trimmed, so shebang text compares equal however the kernel split it.
squish() {
  local -a words
  read -ra words <<<"$1"
  printf '%s' "${words[*]-}"
}

# shebang_rest FILE: succeed if FILE is a regular file whose first line is
# "#!exe" followed by a blank or nothing. The rest of that line (leading blanks
# and any CR removed) is left in SHEBANG_REST.
# This runs on every argument, and some of them may be huge binaries, so it
# reads at most 4 KiB and stops at the first NUL byte (read -d ''). A plain
# read skips NULs, and would scan a zero-filled disk image all the way through.
SHEBANG_REST=''
shebang_rest() {
  local line=''
  [[ -f $1 && -r $1 ]] || return 1
  # read fails on EOF before 4096 chars, but still fills $line
  IFS= read -r -d '' -n 4096 line <"$1" || [[ -n $line ]] || return 1
  line=${line%%$'\n'*}
  line=${line%$'\r'}
  [[ $line == '#!exe' || $line == '#!exe'[[:blank:]]* ]] || return 1
  ((${#line} < 4096)) || die "shebang line in $1 is too long"
  line=${line#'#!exe'}
  SHEBANG_REST=${line#"${line%%[![:blank:]]*}"}
}

# split_words STRING: split STRING on blanks into the global array WORDS,
# honouring '...' and "..." quoting and backslash escapes the way a shell does,
# but without expanding anything.
split_words() {
  local s=$1 c next q='' word='' have_word=0 i
  local n=${#s}
  WORDS=()
  for ((i = 0; i < n; i++)); do
    c=${s:i:1}
    if [[ $q == "'" ]]; then
      if [[ $c == "'" ]]; then q=''; else word+=$c; fi
    elif [[ $q == '"' ]]; then
      if [[ $c == '"' ]]; then
        q=''
      elif [[ $c == '\' ]] && ((i + 1 < n)); then
        next=${s:i+1:1}
        case $next in
        '"' | '\' | '$' | '`')
          word+=$next
          i=$((i + 1))
          ;;
        *) word+=$c ;;
        esac
      else
        word+=$c
      fi
    else
      case $c in
      [[:blank:]])
        if ((have_word)); then
          WORDS+=("$word")
          word=''
          have_word=0
        fi
        ;;
      "'")
        q="'"
        have_word=1
        ;;
      '"')
        q='"'
        have_word=1
        ;;
      '\')
        ((i + 1 < n)) || die "trailing backslash in shebang line of $script"
        word+=${s:i+1:1}
        i=$((i + 1))
        have_word=1
        ;;
      *)
        word+=$c
        have_word=1
        ;;
      esac
    fi
  done
  [[ -z $q ]] || die "unterminated $q quote in shebang line of $script"
  if ((have_word)); then WORDS+=("$word"); fi
}

# Find the script among our arguments. Run by hand ("exe script ...") it is $1.
# Run through a "#!exe ..." line, the kernel puts the shebang's arguments in
# front of it: Linux as ONE word, macOS split on blanks. So a candidate only
# counts if the arguments before it match the text of its own shebang line.
# That way "exe cat main.tl" is still just cat, even if main.tl is an #!exe
# script, and a shebang that names its own script (#!exe tl gen main.tl)
# can't be mistaken for it.
script_idx=0
for ((i = 1; i <= $#; i++)); do
  shebang_rest "${!i}" || continue
  if ((i > 1)); then
    pre=''
    for ((j = 1; j < i; j++)); do
      pre+="${!j} "
    done
    # a CRLF shebang line leaves a CR on the kernel's last argument
    [[ "$(squish "${pre//$'\r'/}")" == "$(squish "$SHEBANG_REST")" ]] || continue
  fi
  script_idx=$i
  break
done

# Not one of ours: behave like plain exec.
((script_idx)) || exec -- "$@"

shift $((script_idx - 1))
script=$1
shift

# --pop-shebang may appear anywhere after the script; everything else is
# forwarded to the command.
pop_shebang=0
user_args=()
for arg in "$@"; do
  if [[ $arg == --pop-shebang ]]; then
    pop_shebang=1
  else
    user_args+=("$arg")
  fi
done

split_words "$SHEBANG_REST"
((${#WORDS[@]})) || die "empty command after #!exe in $script"

if ((pop_shebang)); then
  # skip the first line (the shebang) and feed the rest to stdin
  exec -- "${WORDS[@]}" ${user_args[@]+"${user_args[@]}"} < <(tail -n +2 -- "$script")
else
  # execute the parsed command with the whole script on stdin
  exec -- "${WORDS[@]}" ${user_args[@]+"${user_args[@]}"} <"$script"
fi
